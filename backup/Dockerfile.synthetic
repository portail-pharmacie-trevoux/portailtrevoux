FROM postgres:18-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir boto3==1.40.69 cryptography==46.0.3
ENV PATH="/opt/venv/bin:$PATH"
WORKDIR /opt/backup
COPY backup/backup.py /opt/backup/backup.py
COPY backup/render-synthetic-test.sh /opt/backup/render-synthetic-test.sh
COPY backup/test-scaleway-synthetic.py /opt/backup/test-scaleway-synthetic.py
COPY backup/check-backup-freshness.py /opt/backup/check-backup-freshness.py
COPY backup/send-test-alert.py /opt/backup/send-test-alert.py
RUN chmod +x /opt/backup/render-synthetic-test.sh
CMD ["/opt/backup/render-synthetic-test.sh"]
